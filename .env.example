# Edusync Environment Variables Template
# Copy this file to .env and fill in the values below.

# Django Secret Key (Generate a random string for production)
SECRET_KEY=your_django_secret_key_here

# Set to True for development, False for production
DEBUG=True

# Gemini API Key for AI features (Get one from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
