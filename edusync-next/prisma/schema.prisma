generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model auth_group {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique(map: "sqlite_autoindex_auth_group_1")
  auth_group_permissions auth_group_permissions[]
  auth_user_groups       auth_user_groups[]
}

model auth_group_permissions {
  id              Int             @id @default(autoincrement())
  group_id        Int
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_group      auth_group      @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([group_id, permission_id], map: "auth_group_permissions_group_id_permission_id_0cd325b0_uniq")
  @@index([permission_id], map: "auth_group_permissions_permission_id_84c5c92e")
  @@index([group_id], map: "auth_group_permissions_group_id_b120cbf9")
}

model auth_permission {
  id                         Int                          @id @default(autoincrement())
  content_type_id            Int
  codename                   String
  name                       String
  auth_group_permissions     auth_group_permissions[]
  django_content_type        django_content_type          @relation(fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user_user_permissions auth_user_user_permissions[]

  @@unique([content_type_id, codename], map: "auth_permission_content_type_id_codename_01ab375a_uniq")
  @@index([content_type_id], map: "auth_permission_content_type_id_2f476e4b")
}

model auth_user {
  id                         Int                          @id @default(autoincrement())
  password                   String
  last_login                 DateTime?
  is_superuser               Boolean
  username                   String                       @unique(map: "sqlite_autoindex_auth_user_1")
  last_name                  String
  email                      String
  is_staff                   Boolean
  is_active                  Boolean
  date_joined                DateTime
  first_name                 String
  auth_user_groups           auth_user_groups[]
  auth_user_user_permissions auth_user_user_permissions[]
  django_admin_log           django_admin_log[]
  management_course          management_course[]
  management_event           management_event[]
  management_notice          management_notice[]
  management_student         management_student[]
}

model auth_user_groups {
  id         Int        @id @default(autoincrement())
  user_id    Int
  group_id   Int
  auth_group auth_group @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user  auth_user  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, group_id], map: "auth_user_groups_user_id_group_id_94350c0c_uniq")
  @@index([group_id], map: "auth_user_groups_group_id_97559544")
  @@index([user_id], map: "auth_user_groups_user_id_6a12ed8b")
}

model auth_user_user_permissions {
  id              Int             @id @default(autoincrement())
  user_id         Int
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user       auth_user       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, permission_id], map: "auth_user_user_permissions_user_id_permission_id_14a6b632_uniq")
  @@index([permission_id], map: "auth_user_user_permissions_permission_id_1fbb5f2c")
  @@index([user_id], map: "auth_user_user_permissions_user_id_a95ead1b")
}

model django_admin_log {
  id                  Int                              @id @default(autoincrement())
  object_id           String?
  object_repr         String
  action_flag         Int
  change_message      String
  content_type_id     Int?
  user_id             Int
  action_time         DateTime
  auth_user           auth_user                        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  django_content_type django_content_type?             @relation(fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "django_admin_log_user_id_c564eba6")
  @@index([content_type_id], map: "django_admin_log_content_type_id_c4bce8eb")
}

model django_content_type {
  id               Int                @id @default(autoincrement())
  app_label        String
  model            String
  auth_permission  auth_permission[]
  django_admin_log django_admin_log[]

  @@unique([app_label, model], map: "django_content_type_app_label_model_76bd3d3b_uniq")
}

model django_migrations {
  id      Int      @id @default(autoincrement())
  app     String
  name    String
  applied DateTime
}

model django_session {
  session_key  String   @id
  session_data String
  expire_date  DateTime

  @@index([expire_date], map: "django_session_expire_date_a5c62663")
}

model management_attendance {
  id                 Int                @id @default(autoincrement())
  date               DateTime
  status             String
  course_id          Int
  student_id         Int
  management_student management_student @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  management_course  management_course  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, course_id, date], map: "management_attendance_student_id_course_id_date_68ae44f6_uniq")
  @@index([student_id], map: "management_attendance_student_id_52c19ca4")
  @@index([course_id], map: "management_attendance_course_id_35afd1f6")
}

model management_course {
  id                    Int                     @id @default(autoincrement())
  class_name            String
  teacher_id            Int?
  management_attendance management_attendance[]
  auth_user             auth_user?              @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  management_enrollment management_enrollment[]
  management_homework   management_homework[]
  management_material   management_material[]
  management_schedule   management_schedule[]
  management_score      management_score[]

  @@index([teacher_id], map: "management_course_teacher_id_62ed651c")
}

model management_enrollment {
  id                 Int                @id @default(autoincrement())
  course_id          Int
  student_id         Int
  management_student management_student @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  management_course  management_course  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, course_id], map: "management_enrollment_student_id_course_id_81447bce_uniq")
  @@index([student_id], map: "management_enrollment_student_id_cf162438")
  @@index([course_id], map: "management_enrollment_course_id_43f9412b")
}

model management_event {
  id         Int                  @id @default(autoincrement())
  title      String
  date       DateTime
  start_time DateTime
  end_time   DateTime?
  audience   String
  teacher_id Int?
  auth_user  auth_user?           @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([teacher_id], map: "management_event_teacher_id_f41bbaeb")
}

model management_homework {
  id                            Int                             @id @default(autoincrement())
  title                         String
  deadline                      DateTime
  course_id                     Int
  management_course             management_course               @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  management_homeworksubmission management_homeworksubmission[]

  @@index([course_id], map: "management_homework_course_id_88baa494")
}

model management_homeworksubmission {
  id                  Int                 @id @default(autoincrement())
  status              String
  homework_id         Int
  student_id          Int
  management_student  management_student  @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  management_homework management_homework @relation(fields: [homework_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, homework_id], map: "management_homeworksubmission_student_id_homework_id_7c0d006b_uniq")
  @@index([student_id], map: "management_homeworksubmission_student_id_d03afae5")
  @@index([homework_id], map: "management_homeworksubmission_homework_id_b465d080")
}

model management_invitecode {
  id         Int                 @id @default(autoincrement())
  code       String              @unique(map: "sqlite_autoindex_management_invitecode_1")
  is_active  Boolean
  created_at DateTime
}

model management_material {
  id                Int               @id @default(autoincrement())
  title             String
  file              String
  uploaded_at       DateTime
  course_id         Int
  management_course management_course @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([course_id], map: "management_material_course_id_a7fbff67")
}

model management_notice {
  id          Int        @id @default(autoincrement())
  title       String
  content     String
  author_name String
  created_at  DateTime
  icon        String
  teacher_id  Int?
  auth_user   auth_user? @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([teacher_id], map: "management_notice_teacher_id_bed93405")
}

model management_schedule {
  id                Int                 @id @default(autoincrement())
  day               String
  start_time        DateTime
  end_time          DateTime
  course_id         Int
  management_course management_course   @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([course_id], map: "management_schedule_course_id_b1ee1d13")
}

model management_score {
  id                 Int                @id @default(autoincrement())
  score_type         String
  value              Float
  course_id          Int
  student_id         Int
  date               DateTime?
  management_student management_student @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  management_course  management_course  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([student_id], map: "management_score_student_id_9f50f5e1")
  @@index([course_id], map: "management_score_course_id_6c27aa74")
}

model management_student {
  id                            Int                             @id @default(autoincrement())
  student_id                    String                          @unique(map: "sqlite_autoindex_management_student_1")
  name                          String
  gender                        String
  grade                         String
  phone                         String?
  parent_phone                  String
  join_date                     DateTime
  photo                         String?
  teacher_id                    Int?
  management_attendance         management_attendance[]
  management_enrollment         management_enrollment[]
  management_homeworksubmission management_homeworksubmission[]
  management_score              management_score[]
  auth_user                     auth_user?                      @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([teacher_id], map: "management_student_teacher_id_b0b3cd07")
}
